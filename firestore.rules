rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // อนุญาตเฉพาะอีเมลในลิสต์นี้ (เพิ่มอีเมลคนในร้านได้ คั่นด้วยจุลภาค)
    // ข้อมูลสต๊อก
    match /shops/{shopId} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ["the_basketballs@hotmail.com"];
    }
    // รูปสินค้า (เก็บเป็นข้อมูลรูปแบบฟรีใน Firestore)
    match /product_images/{imgId} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ["the_basketballs@hotmail.com"];
    }
  }
}
